<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="raw_vehicle_cmd_converter_param_path" default=""/>
  <arg name="initial_engage_state" default="false"/>
  <arg name="serial_port" default="$(env SERIAL_PORT __autoracer_serial_port_unset__)"/>
  <arg name="serial_baudrate" default="$(env SERIAL_BAUDRATE 115200)"/>
  <arg name="max_speed_mps" default="$(env MAX_SPEED_MPS 3.0)"/>
  <arg name="enable_drive_commands" default="$(env ENABLE_DRIVE_COMMANDS false)"/>
  <arg name="control_topic" default="/control/command/control_cmd"/>
  <arg name="safe_control_topic" default="/autoracer/control/safe_control_cmd"/>

  <node pkg="autoracer_safety" exec="command_gate" name="command_gate" output="screen">
    <param name="enable_drive_commands" value="$(var enable_drive_commands)"/>
    <param name="input_topic" value="$(var control_topic)"/>
    <param name="output_topic" value="$(var safe_control_topic)"/>
    <param name="max_speed_mps" value="$(var max_speed_mps)"/>
    <param name="max_steer_rad" value="0.262"/>
    <param name="max_steer_rate_radps" value="$(env CONTROL_MAX_STEER_RATE_RADPS 1.5)"/>
  </node>

  <node pkg="autoracer_vehicle_interface" exec="rc_serial_interface" name="rc_serial_interface" output="screen">
    <param name="port" value="$(var serial_port)"/>
    <param name="baudrate" value="$(var serial_baudrate)"/>
    <param name="wheel_base_m" value="0.6"/>
    <param name="max_speed_mps" value="$(var max_speed_mps)"/>
    <param name="max_steer_rad" value="0.262"/>
    <param name="start_in_autonomous" value="$(var initial_engage_state)"/>
    <param name="control_topic" value="$(var safe_control_topic)"/>
  </node>

  <node pkg="autoracer_vehicle_interface" exec="vehicle_velocity_converter" name="vehicle_velocity_converter" namespace="sensing" output="screen">
    <param name="input_topic" value="/vehicle/status/velocity_status"/>
    <param name="output_topic" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
  </node>
</launch>
