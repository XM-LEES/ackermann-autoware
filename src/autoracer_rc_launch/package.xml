<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoracer_rc_launch</name>
  <version>0.1.0</version>
  <description>Official Autoware vehicle launch adapter for the Autoracer RC platform.</description>
  <maintainer email="autoracer@example.com">Autoracer Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>autoracer_safety</exec_depend>
  <exec_depend>autoracer_vehicle_interface</exec_depend>
  <exec_depend>autoware_localization_rviz_plugin</exec_depend>
  <exec_depend>autoware_planning_rviz_plugin</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tier4_adapi_rviz_plugin</exec_depend>
  <exec_depend>tier4_control_mode_rviz_plugin</exec_depend>
  <exec_depend>tier4_planning_factor_rviz_plugin</exec_depend>
  <exec_depend>tier4_state_rviz_plugin</exec_depend>
  <exec_depend>tier4_vehicle_rviz_plugin</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
