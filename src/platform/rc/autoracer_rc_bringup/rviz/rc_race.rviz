Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: Vehicle TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0
      Value: true
    - Alpha: 0.35
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -2
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 170; 170; 170
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: PCD Map
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map/pointcloud_map
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -2
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 170; 0
      Color Transformer: FlatColor
      Decay Time: 0.2
      Enabled: true
      Name: Live C32 PointCloud
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /sensing/lidar/concatenated/pointcloud
      Use Fixed Frame: true
      Value: true
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: Localized Vehicle
      Position Tolerance: 0.05
      Shape:
        Alpha: 1
        Axes Length: 0.4
        Axes Radius: 0.03
        Color: 0; 255; 80
        Head Length: 0.15
        Head Radius: 0.06
        Shaft Length: 0.25
        Shaft Radius: 0.03
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization/kinematic_state
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Recorded Course
      Namespaces:
        autoracer_fixed_course: true
        autoracer_fixed_course_finish: true
        autoracer_fixed_course_start: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/course_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Tracking Trajectory
      Namespaces:
        autoracer_local_trajectory: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/local_trajectory_marker
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 26; 28
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Top Down
      Scale: 12
      Target Frame: base_link
      X: 0
      Y: 0
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
