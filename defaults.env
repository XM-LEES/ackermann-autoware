: "${LAUNCH_SENSING:=true}"
: "${LAUNCH_LOCALIZATION:=true}"
: "${LAUNCH_PLANNING:=true}"
: "${LAUNCH_CONTROL:=true}"
: "${LAUNCH_VEHICLE:=true}"
: "${LAUNCH_RVIZ:=false}"
: "${LAUNCH_IMU:=true}"

: "${ENABLE_DRIVE_COMMANDS:=false}"
: "${MAX_SPEED_MPS:=3.0}"
: "${SERIAL_PORT:=/dev/ttyCH343USB0}"
: "${SERIAL_BAUDRATE:=115200}"
: "${IMU_SERIAL_PORT:=/dev/ttyUSB0}"
: "${IMU_BAUDRATE:=115200}"
: "${CONTROL_MAX_STEER_RATE_RADPS:=1.5}"

: "${LIDAR_IFACE:=enP8p1s0}"
: "${LIDAR_HOST_IP:=192.168.1.102}"
: "${LIDAR_SENSOR_IP:=192.168.1.200}"

: "${LAUNCH_POINTCLOUD_FILTER:=true}"
: "${POINTCLOUD_FILTER_LEAF_SIZE_M:=0.25}"
: "${POINTCLOUD_FILTER_MIN_RANGE_M:=0.15}"
: "${POINTCLOUD_FILTER_MAX_RANGE_M:=60.0}"
: "${POINTCLOUD_FILTER_MAX_POINTS:=1500}"
